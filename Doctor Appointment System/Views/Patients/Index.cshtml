@model IEnumerable<DoctorAppointmentSystem.Models.Patient>

@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold" style="color: #1a73e8;">
        <i class="fas fa-procedures me-2"></i>All Patients
    </h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add New Patient
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th><i class="fas fa-hashtag me-1"></i>#</th>
                <th><i class="fas fa-user me-1"></i>Name</th>
                <th><i class="fas fa-birthday-cake me-1"></i>Date of Birth</th>
                <th><i class="fas fa-envelope me-1"></i>Email</th>
                <th><i class="fas fa-phone me-1"></i>Phone</th>
                <th><i class="fas fa-map-marker me-1"></i>Address</th>
                <th><i class="fas fa-cogs me-1"></i>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-inline-flex
                                align-items-center justify-content-center me-2"
                                 style="width:35px; height:35px;
                                background: linear-gradient(135deg, #1a73e8, #0d47a1);">
                                <i class="fas fa-user text-white small"></i>
                            </div>
                            <strong>@item.Name</strong>
                        </div>
                    </td>
                    <td>@item.DateOfBirth.ToString("dd MMM yyyy")</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-info text-white me-1">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning me-1">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-procedures fa-4x text-muted mb-3"></i>
        <h4 class="text-muted">No patients found</h4>
        <a asp-action="Create" class="btn btn-primary mt-2">
            <i class="fas fa-plus me-2"></i>Add First Patient
        </a>
    </div>
}