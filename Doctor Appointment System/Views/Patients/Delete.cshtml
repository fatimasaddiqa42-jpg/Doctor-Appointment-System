@model DoctorAppointmentSystem.Models.Patient

@{
    ViewData["Title"] = "Delete Patient";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0">
                    <i class="fas fa-trash me-2"></i>
                    Do you want to delete this patient?
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="rounded-circle d-inline-flex
                        align-items-center justify-content-center mb-3"
                         style="width:80px; height:80px;
                        background: #dc3545;">
                        <i class="fas fa-user fa-2x text-white"></i>
                    </div>
                    <h5 class="fw-bold">@Model.Name</h5>
                </div>

                <table class="table table-borderless">
                    <tr>
                        <td class="fw-bold" style="width:40%">
                            <i class="fas fa-user me-2 text-danger"></i>Name:
                        </td>
                        <td>@Model.Name</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-birthday-cake me-2 text-danger"></i>
                            Date of Birth:
                        </td>
                        <td>@Model.DateOfBirth.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-envelope me-2 text-danger"></i>
                            Email:
                        </td>
                        <td>@Model.Email</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-phone me-2 text-danger"></i>
                            Phone:
                        </td>
                        <td>@Model.Phone</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-map-marker me-2 text-danger"></i>
                            Address:
                        </td>
                        <td>@Model.Address</td>
                    </tr>
                </table>

                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> Deleting this patient will also delete all its appointments!
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>
                            Yes, Delete
                        </button>
                        <a asp-action="Index"
                               class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>
                            No, Go Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>