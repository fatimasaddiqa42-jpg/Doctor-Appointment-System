@model DoctorAppointmentSystem.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header text-white py-3"
                 style="background: linear-gradient(135deg, #1a73e8, #0d47a1);">
                <h4 class="mb-0">
                    <i class="fas fa-calendar-check me-2"></i>
                    Appointment Details
                </h4>
            </div>
            <div class="card-body p-4">
                <table class="table table-borderless">
                    <tr>
                        <td class="fw-bold" style="width:40%">
                            <i class="fas fa-hashtag me-2 text-primary"></i>ID:
                        </td>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-user-md me-2 text-primary"></i>
                            Doctor:
                        </td>
                        <td>
                            @Model.Doctor.Name
                            <br />
                            <small class="text-muted">
                                @Model.Doctor.Specialization
                            </small>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-procedures me-2 text-primary"></i>
                            Patient:
                        </td>
                        <td>@Model.Patient.Name</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-calendar me-2 text-primary"></i>
                            Date & Time:
                        </td>
                        <td>
                            @Model.AppointmentDate.ToString("dd MMM yyyy hh:mm tt")
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-info-circle me-2 text-primary"></i>
                            Status:
                        </td>
                        <td>
                            @if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-clock me-1"></i>Pending
                                </span>
                            }
                            else if (Model.Status == "Confirmed")
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check me-1"></i>Confirmed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-times me-1"></i>Cancelled
                                </span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-sticky-note me-2 text-primary"></i>
                            Notes:
                        </td>
                        <td>@(Model.Notes ?? "No notes available")</td>
                    </tr>
                </table>

                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                           class="btn btn-warning">
                        <i class="fas fa-edit me-2"></i>Edit
                    </a>
                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Go Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>