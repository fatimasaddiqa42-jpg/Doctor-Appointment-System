@model DoctorAppointmentSystem.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0">
                    <i class="fas fa-trash me-2"></i>
                    Do you want to delete this appointment?
                </h4>
            </div>
            <div class="card-body p-4">
                <table class="table table-borderless">
                    <tr>
                        <td class="fw-bold" style="width:40%">
                            <i class="fas fa-user-md me-2 text-danger"></i>
                            Doctor:
                        </td>
                        <td>
                            @Model.Doctor.Name
                            <br />
                            <small class="text-muted">
                                @Model.Doctor.Specialization
                            </small>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-procedures me-2 text-danger"></i>
                            Patient:
                        </td>
                        <td>@Model.Patient.Name</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-calendar me-2 text-danger"></i>
                            Date & Time:
                        </td>
                        <td>
                            @Model.AppointmentDate.ToString("dd MMM yyyy hh:mm tt")
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-info-circle me-2 text-danger"></i>
                            Status:
                        </td>
                        <td>
                            @if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">
                                    @Model.Status
                                </span>
                            }
                            else if (Model.Status == "Confirmed")
                            {
                                <span class="badge bg-success">
                                    @Model.Status
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    @Model.Status
                                </span>
                            }
                        </td>
                    </tr>
                    @if (Model.Notes != null)
                    {
                        <tr>
                            <td class="fw-bold">
                                <i class="fas fa-sticky-note me-2 text-danger"></i>
                                Notes:
                            </td>
                            <td>@Model.Notes</td>
                        </tr>
                    }
                </table>

                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong>
                    This action cannot be undone!
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>
                            Yes, Delete
                        </button>
                        <a asp-action="Index"
                               class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>
                            No, Go Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>