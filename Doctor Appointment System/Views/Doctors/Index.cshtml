@model IEnumerable<DoctorAppointmentSystem.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold" style="color: #1a73e8;">
        <i class="fas fa-user-md me-2"></i>All Doctors
    </h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add New Doctor
    </a>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle d-inline-flex
                        align-items-center justify-content-center mb-3"
                         style="width:80px; height:80px;
                        background: linear-gradient(135deg, #1a73e8, #0d47a1);">
                        <i class="fas fa-user-md fa-2x text-white"></i>
                    </div>
                    <h5 class="card-title fw-bold">@item.Name</h5>
                    <span class="badge mb-2"
                          style="background: linear-gradient(135deg, #1a73e8, #0d47a1);">
                        @item.Specialization
                    </span>
                    <p class="card-text text-muted mb-1">
                        <i class="fas fa-envelope me-1"></i>@item.Email
                    </p>
                    <p class="card-text text-muted">
                        <i class="fas fa-phone me-1"></i>@item.Phone
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0
                    text-center pb-3">
                    <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-sm btn-info text-white me-1">
                        <i class="fas fa-eye me-1"></i>Details
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-warning me-1">
                        <i class="fas fa-edit me-1"></i>Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger">
                        <i class="fas fa-trash me-1"></i>Delete
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-user-md fa-4x text-muted mb-3"></i>
        <h4 class="text-muted">No doctors found</h4>
        <a asp-action="Create" class="btn btn-primary mt-2">
            <i class="fas fa-plus me-2"></i>Add First Doctor
        </a>
    </div>
}